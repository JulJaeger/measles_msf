) %>%
arrange(Referral_Source)
# -----------------------------------------------------
# SECTION 8 — REFERRAL TO HIGHER-LEVEL CARE (FROM IPD)
# -----------------------------------------------------
referral_to_ipd <- measles_data %>%
filter(ipd_opd == "IPD") %>%
mutate(
referred_to = tolower(trimws(if_referred_where))
) %>%
filter(!is.na(referred_to), referred_to != "") %>%
mutate(
Referred_To = case_when(
referred_to == "oca_ktp"       ~ "OCA KTP",
referred_to == "ocp_goyalmara" ~ "OCP Goyalmara",
TRUE                           ~ NA_character_
)
) %>%
filter(!is.na(Referred_To)) %>%
count(Referred_To, name = "N") %>%
mutate(
Denominator = N_IPD,
`% of IPD`  = round(N / Denominator * 100, 2)
)
total_referred_out <- referral_to_ipd %>%
summarise(
Referred_To = "Total referred out (any facility)",
N           = sum(N),
Denominator = N_IPD,
`% of IPD`  = round(N / Denominator * 100, 2)
)
referral_to_final <- bind_rows(referral_to_ipd, total_referred_out)
# -----------------------------------------------------
# COMBINE WITH SUBHEADERS
# -----------------------------------------------------
from_header <- tibble(
Referral_Source = "REFERRALS FROM",
N_IPD = NA_real_,
Denominator = NA_real_,
`% of IPD` = NA_real_
)
to_header <- tibble(
Referral_Source = "REFERRALS TO",
N_IPD = NA_real_,
Denominator = NA_real_,
`% of IPD` = NA_real_
)
referral_from_table <- referral_ipd %>%
transmute(Referral_Source, N_IPD, Denominator, `% of IPD`)
referral_to_table <- referral_to_final %>%
transmute(
Referral_Source = Referred_To,
N_IPD = N,
Denominator,
`% of IPD`
)
referral_combined <- bind_rows(
from_header,
referral_from_table,
to_header,
referral_to_table
)
# -----------------------------------------------------
# GT TABLE OUTPUT
# -----------------------------------------------------
referral_gt <- referral_combined %>%
gt() %>%
# ---- Title ----
tab_header(
title = md("**Referrals IPD**")
) %>%
# ---- Column labels ----
cols_label(
Referral_Source = "Referral Source",
N_IPD           = "N referred",
Denominator     = "Total IPD",
`% of IPD`      = "% referred"
) %>%
# ---- Alignment ----
cols_align(
align = "center",
columns = c(N_IPD, Denominator, `% of IPD`)
) %>%
cols_align(
align = "left",
columns = Referral_Source
) %>%
# ---- Typography ----
opt_table_font(
font = list(google_font("Roboto"), default_fonts())
) %>%
opt_align_table_header(align = "left") %>%
# ---- Title bar ----
tab_style(
style = list(
cell_fill(color = "#008CBA"),
cell_text(color = "white", weight = "bold")
),
locations = cells_title(groups = "title")
) %>%
# ---- Column headers ----
tab_style(
style = cell_text(color = "#008CBA", weight = "bold"),
locations = cells_column_labels(everything())
) %>%
# ---- Body text ----
tab_style(
style = cell_text(color = "black"),
locations = cells_body()
) %>%
# ---- Subheaders (blue, bold) ----
tab_style(
style = cell_text(color = "#008CBA", weight = "bold"),
locations = cells_body(
rows = Referral_Source %in% c("REFERRALS FROM", "REFERRALS TO")
)
) %>%
# ---- Hide NA values next to subheaders (version-safe) ----
tab_style(
style = cell_text(color = "transparent"),
locations = cells_body(
rows = Referral_Source %in% c("REFERRALS FROM", "REFERRALS TO"),
columns = c(N_IPD, Denominator, `% of IPD`)
)
) %>%
# ---- Column widths ----
cols_width(
Referral_Source ~ px(260),
everything()    ~ px(120)
)
# Print table
referral_gt
#| title: "Patient Origin"
#| fig.asp: 1
#| out.width: 100%
#| fig.align: center
#| fig.margin: 0
library(dplyr)
library(gt)
# --------------------------------------------------
# Standardise camp names
# --------------------------------------------------
measles_camp <- measles_data %>%
mutate(
Camp = case_when(
camp %in% c("14", "Camp 14") ~ "Camp 14",
camp %in% c("15", "Camp 15") ~ "Camp 15",
camp %in% c("16", "Camp 16") ~ "Camp 16",
TRUE                         ~ "Other"
)
)
# --------------------------------------------------
# Case counts by camp (ALL cases)
# --------------------------------------------------
camp_cases <- measles_camp %>%
group_by(Camp) %>%
summarise(
`ALL Cases` = n(),
IPD_N       = sum(ipd_opd == "IPD", na.rm = TRUE),
Simple_N    = sum(clinical_severity == "simple", na.rm = TRUE),
Severe_N    = sum(clinical_severity == "severe", na.rm = TRUE),
.groups = "drop"
)
# --------------------------------------------------
# Camp population (for attack rate)
# --------------------------------------------------
camp_population_clean <- camp_population %>%
mutate(
Camp = case_when(
`Camp / Location` %in% c("Camp 14", "Camp 15", "Camp 16") ~ `Camp / Location`,
TRUE                                                     ~ "Other"
)
) %>%
group_by(Camp) %>%
summarise(
Population = sum(`Pop (At Risk)`),
.groups = "drop"
)
# --------------------------------------------------
# Final table data (NO IPD SUBSECTION)
# --------------------------------------------------
camp_table <- camp_cases %>%
left_join(camp_population_clean, by = "Camp") %>%
mutate(
`% Total` = round(`ALL Cases` / sum(`ALL Cases`) * 100, 1),
`Attack Rate /1k` = round((`ALL Cases` / Population) * 1000, 3)
) %>%
arrange(factor(Camp, levels = c("Camp 14", "Camp 15", "Camp 16", "Other"))) %>%
transmute(
Camp,
`ALL Cases`,
`% Total`,
IPD_N,
Simple_N,
Severe_N,
`Attack Rate /1k`
)
# --------------------------------------------------
# GT table rendering
# --------------------------------------------------
camp_gt <- camp_table %>%
gt() %>%
tab_header(
title = md("**Patients Origin by Camp**")
) %>%
cols_label(
Camp              = "Camp / Location",
`ALL Cases`       = "All Cases",
`% Total`         = "% Total",
IPD_N             = "IPD (N)",
Simple_N          = "Simple (N)",
Severe_N          = "Severe (N)",
`Attack Rate /1k` = "Attack Rate /1k"
) %>%
cols_align("left", Camp) %>%
cols_align(
"right",
c(`ALL Cases`, `% Total`, IPD_N, Simple_N, Severe_N, `Attack Rate /1k`)
) %>%
opt_table_font(
font = list(google_font("Roboto"), default_fonts())
) %>%
opt_align_table_header(align = "left") %>%
# Title bar
tab_style(
style = list(
cell_fill(color = "#008CBA"),
cell_text(color = "white", weight = "bold")
),
locations = cells_title(groups = "title")
) %>%
# Column headers
tab_style(
style = cell_text(color = "#008CBA", weight = "bold"),
locations = cells_column_labels()
) %>%
# Body text
tab_style(
style = cell_text(color = "black"),
locations = cells_body()
) %>%
cols_width(
Camp ~ px(230),
everything() ~ px(120)
)
camp_gt
#| title: "Co-diagnoses"
#| fig.asp: 1
#| out.width: 100%
#| fig.align: center
## Denominators#| fig.margin: 0
# --------------------------------------------------
N_IPD <- measles_data %>%
filter(ipd_opd == "IPD") %>%
nrow()
N_all <- nrow(measles_data)   # ✅ ADD BACK: total cases
# --------------------------------------------------
# Long format final diagnoses (IPD only)
# --------------------------------------------------
final_dx_long <- measles_data %>%
filter(ipd_opd == "IPD") %>%
dplyr::select(
starts_with("final_diagnoses_"),
-any_of("final_diagnoses_measles")
) %>%
mutate(
across(everything(), ~ .x == "TRUE")
) %>%
pivot_longer(
cols = everything(),
names_to  = "Diagnosis",
values_to = "Present"
) %>%
filter(Present)
# --------------------------------------------------
# Co-diagnosis counts
# --------------------------------------------------
co_dx_final <- final_dx_long %>%
count(Diagnosis, name = "Numerator") %>%
mutate(
`Denominator (IPD)`   = N_IPD,
`% of IPD Admissions` = round(Numerator / N_IPD * 100, 2),
`% of All Cases`      = round(Numerator / N_all * 100, 2),  # ✅ RESTORED
Diagnosis = gsub("final_diagnoses_", "+ ", Diagnosis),
Diagnosis = gsub("_", " ", Diagnosis),
Diagnosis = tools::toTitleCase(Diagnosis)
) %>%
arrange(desc(Numerator))
# --------------------------------------------------
# GT table
# --------------------------------------------------
co_dx_gt <- co_dx_final %>%
gt() %>%
tab_header(
title = md("**Co‑Diagnoses (IPD Patients)**")
) %>%
cols_label(
Diagnosis             = "Co‑Diagnosis",
Numerator             = "N (IPD)",
`Denominator (IPD)`   = "Total IPD",
`% of IPD Admissions` = "% of IPD",
`% of All Cases`      = "% of All Cases"   # ✅ RESTORED
) %>%
cols_align(align = "left", columns = "Diagnosis") %>%
cols_align(
align = "center",
columns = c(
"Numerator",
"Denominator (IPD)",
"% of IPD Admissions",
"% of All Cases"
)
) %>%
opt_table_font(
font = list(google_font("Roboto"), default_fonts())
) %>%
opt_align_table_header(align = "left") %>%
# Title bar
tab_style(
style = list(
cell_fill(color = "#008CBA"),
cell_text(color = "white", weight = "bold")
),
locations = cells_title(groups = "title")
) %>%
# Column headers
tab_style(
style = cell_text(color = "#008CBA", weight = "bold"),
locations = cells_column_labels()
) %>%
# Body text
tab_style(
style = cell_text(color = "black"),
locations = cells_body()
) %>%
cols_width(
Diagnosis ~ px(260),
everything() ~ px(130)
)
co_dx_gt
library(gt)
# --------------------------------------------------
#| title: "Complications IPD"
#| fig.asp: 1
#| out.width: 100%
#| fig.align: center
#| fig.margin: 0
# ---- Any complication (at least one) ----
complications_ipd <- ipd %>%
dplyr::select(
starts_with("complications_"),
-complications_none
) %>%
mutate(across(
everything(),
~ .x %in% c(TRUE, "TRUE", "true")
))
any_complication_n <- ipd |>
dplyr::select(
starts_with("complications_"),
-complications_none
) |>
dplyr::mutate(across(everything(), ~ .x %in% c(TRUE, "TRUE", "true"))) |>
rowSums(na.rm = TRUE) |>
(\(x) sum(x > 0))()
complication_prop <- complications_ipd %>%
summarise(across(everything(), ~ sum(.x, na.rm = TRUE))) %>%
tidyr::pivot_longer(
cols = everything(),
names_to = "complication",
values_to = "n"
) %>%
mutate(
complication = stringr::str_remove(complication, "^complications_"),
pct = round(n / N_IPD * 100, 2)
)
# ---- Total complications for denominator ----
total_complications <- sum(complication_prop$n)
# ---- Build Section 4 table ----
complications_section4 <- tibble::tibble(
`Complication Type` = c(
"Any complication",
str_to_title(complication_prop$complication)
),
`N (IPD)` = c(
any_complication_n,
complication_prop$n
),
Denominator = c(
N_IPD,
rep(N_IPD, nrow(complication_prop))
),
`% of IPD` = c(
round(any_complication_n / N_IPD * 100, 2),
round(complication_prop$n / N_IPD * 100, 2)
))
complications_section4 <- complications_section4 %>%
filter(`Complication Type` != "Any complication")
complication_gt <- complications_section4 %>%
gt() %>%
# Title
tab_header(
title = md("**Complications (IPD Patients)**")
) %>%
# Column labels
cols_label(
`Complication Type` = "Complication Type",
`N (IPD)`           = "IPD (N)",
Denominator         = "Total IPD",
`% of IPD`          = "% Compl. IPD"
) %>%
# Alignment
cols_align(align = "left", columns = "Complication Type") %>%
cols_align(
align = "center",
columns = c("N (IPD)", "Denominator", "% of IPD")
) %>%
# Font
opt_table_font(
font = list(google_font("Roboto"), default_fonts())
) %>%
opt_align_table_header(align = "left") %>%
# Title bar styling
tab_style(
style = list(
cell_fill(color = "#008CBA"),
cell_text(color = "white", weight = "bold")
),
locations = cells_title(groups = "title")
) %>%
# Column headers styling
tab_style(
style = cell_text(color = "#008CBA", weight = "bold"),
locations = cells_column_labels()
) %>%
# Body text styling
tab_style(
style = cell_text(color = "black"),
locations = cells_body()
) %>%
# Column widths
cols_width(
`Complication Type` ~ px(260),
everything() ~ px(130)
)
complication_gt
