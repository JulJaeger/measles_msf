age_range = paste0(min_age, "-", max_age, " years"),
hover_text = paste0(severity_group, " cases: ", cases,
"<br>Age range: ", age_range,
"<br>Epi week: ", epi_week, " (", epi_year, ")")
)
epi_curve <- ggplot(
epi_cases_weekly,
aes(x = factor(epi_week, levels = unique(epi_week)),
y = cases, fill = severity_group, text = hover_text)
) +
geom_col(position = "stack", color = "black", size = 0.1) +
labs(
title = "Weekly aggregated SAM/MAM cases by CDC/MMWR epi week",
x = "Epi Week",
y = "Cases",
fill = "Diagnosis"
) +
theme_minimal() +
theme(
plot.title  = element_text(face = "bold"),
axis.text.x = element_text(angle = 45, hjust = 1),
plot.margin = margin(5, 5, 5, 5)
)
epi_curve_interactive <- ggplotly(epi_curve, tooltip = "text") %>%
style(line = list(width = 0.1)) %>%
config(displayModeBar = FALSE)
epi_curve_interactive
ggsave("epi_curve.png", plot = epi_curve, width = 10, height = 6, dpi = 300)
# Save the interactive Plotly chart as HTML
saveWidget(epi_curve_interactive, "epi_curve_interactive.html")
