# Aggregate epi_cases to weekly counts
epi_cases_weekly <- epi_cases %>%
mutate(iso_week = isoweek(date_of_visit),
iso_year = isoyear(date_of_visit)) %>%
group_by(iso_year, iso_week, ipd_opd) %>%
summarise(
cases = n(),
.groups = "drop"
) %>%
# Create a representative date for plotting (start of ISO week)
mutate(week_date = ISOweek::ISOweek2date(paste0(iso_year, "-W", sprintf("%02d", iso_week), "-1")))
# Now plot weekly aggregated cases
epi_curve <- ggplot(
epi_cases_weekly,
aes(x = week_date, y = cases, fill = ipd_opd, text = paste("Week:", iso_week, "<br>Cases:", cases))
) +
geom_col(position = "stack", color = "black") +
scale_x_date(
date_breaks = "1 week",
date_labels = "%d %b",
expand = c(0, 0)
) +
labs(
title = "Epidemic curve – measles",
subtitle = "Weekly aggregated cases",
x = NULL,
y = "Cases",
fill = NULL
) +
theme_minimal() +
theme(
plot.title = element_text(face = "bold"),
axis.text.x = element_text(angle = 45, hjust = 1),
plot.margin = margin(5, 5, 5, 5),
legend.position = "bottom",
legend.box = "horizontal"
)
epi_curve_interactive <- ggplotly(
epi_curve,
tooltip = "text"
) %>%
config(displayModeBar = FALSE)
epi_curve_interactive
