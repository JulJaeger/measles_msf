epi_cases_weekly <- epi_cases %>%
mutate(
iso_week = isoweek(date_of_visit),
iso_year = isoyear(date_of_visit),
week_label = paste0("Week ", iso_week)
) %>%
group_by(iso_year, iso_week, week_label, ipd_opd) %>%
summarise(
cases = n(),
min_age = min(age, na.rm = TRUE),
max_age = max(age, na.rm = TRUE),
.groups = "drop"
) %>%
mutate(
age_range = paste0(min_age, "-", max_age, " years"),
hover_text = paste(ipd_opd, "=", cases, "<br>Age range:", age_range)
)
