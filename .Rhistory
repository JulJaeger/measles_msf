for (i in seq_along(camp_nums)) {
side <- ifelse(i %% 2 == 1, 0, 1)  # odd = left, even = right
map_1 <- map_1 +
annotate(
"text",
x = side, y = 0.5 - (i-1)*0.05,   # adjust y spacing
label = camp_nums[i],
hjust = ifelse(side == 0, 1.1, -0.1), # push outside
vjust = 0.5,
size = 5, fontface = "bold"
)
}
Extract numeric camp labels from group_2 (skip Nayapara RC)
# Extract numeric camp labels from group_2 (skip Nayapara RC)
camp_nums <- camp_boundaries %>%
filter(CampName_1 %in% group_2, CampName_1 != "Nayapara RC") %>%
mutate(CampLabel = gsub("Camp ", "", CampName_1)) %>%
pull(CampLabel)
# Base map
map_2 <- ggplot() +
geom_sf(
data = sub_blocks %>% filter(CampName_1 %in% group_2),
fill = "white", color = "grey80", linewidth = 0.1
) +
geom_sf(
data = camp_boundaries %>% filter(CampName_1 %in% group_2),
fill = NA, color = "black", linewidth = 0.7
) +
geom_sf(
data = cases_points %>% filter(camp %in% group_2),
aes(color = ipd_opd), size = 3, alpha = 0.7
) +
coord_sf(expand = FALSE) +
theme_light() +
labs(color = "Clinical severity") +
theme(
axis.text = element_blank(),
axis.ticks = element_blank(),
axis.title = element_blank(),
legend.position = "none",
panel.grid = element_blank(),
panel.border = element_rect(colour = "black", fill = NA, linewidth = 0.6),
panel.background = element_blank(),
plot.background = element_blank(),
plot.margin = margin(20, 20, 20, 20) # add space for outside labels
)
# Add alternating labels outside the map
for (i in seq_along(camp_nums)) {
side <- ifelse(i %% 2 == 1, 0, 1)  # odd = left, even = right
map_2 <- map_2 +
annotate(
"text",
x = side, y = 0.9 - (i-1)*0.1,   # adjust vertical spacing
label = camp_nums[i],
hjust = ifelse(side == 0, 1.1, -0.1), # push outside
vjust = 0.5,
size = 5, fontface = "bold"
)
}
map_2
