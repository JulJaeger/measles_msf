complication_gt <- complications_section4 %>%
gt() %>%
# Title
tab_header(
title = md("**Complications (IPD Patients)**")
) %>%
# Column labels
cols_label(
`Complication Type` = "Complication Type",
`N (IPD)`           = "IPD (N)",
Denominator         = "Total IPD",
`% of IPD`          = "% Compl. IPD"
) %>%
# Alignment
cols_align(align = "left", columns = "Complication Type") %>%
cols_align(
align = "center",
columns = c("N (IPD)", "Denominator", "% of IPD")
) %>%
# Font
opt_table_font(
font = list(google_font("Roboto"), default_fonts())
) %>%
opt_align_table_header(align = "left") %>%
# Title bar styling
tab_style(
style = list(
cell_fill(color = "#008CBA"),
cell_text(color = "white", weight = "bold")
),
locations = cells_title(groups = "title")
) %>%
# Column headers styling
tab_style(
style = cell_text(color = "#008CBA", weight = "bold"),
locations = cells_column_labels()
) %>%
# Body text styling
tab_style(
style = cell_text(color = "black"),
locations = cells_body()
) %>%
# Column widths
cols_width(
`Complication Type` ~ px(260),
everything() ~ px(130)
)
complication_gt
map_1 <- ggplot() +
geom_sf(
data = sub_blocks %>% filter(CampName_1 %in% group_1),
fill = "white", color = "grey80", linewidth = 0.1
) +
geom_sf(
data = camp_boundaries %>% filter(CampName_1 %in% group_1),
fill = NA, color = "black", linewidth = 0.7
) +
geom_sf(
data = cases_points %>% filter(camp %in% group_1),
aes(color = ipd_opd), size = 3, alpha = 0.7
) +
# Add camp labels (numbers only)
geom_sf_text(
data = camp_boundaries %>% filter(CampName_1 %in% group_1) %>%
mutate(CampLabel = gsub("Camp ", "", CampName_1)),
aes(label = CampLabel),
size = 5, fontface = "bold"
) +
coord_sf(expand = FALSE) +
theme_light() +
theme(
axis.text = element_blank(),
axis.ticks = element_blank(),
axis.title = element_blank(),
legend.position = "none",
panel.grid = element_blank(),
panel.border = element_rect(colour = "black", fill = NA, linewidth = 0.6),
panel.background = element_blank(),
plot.background = element_blank(),
plot.margin = margin(0, 0, 0, 0)
) +
labs(color = "Clinical severity")
map_1
