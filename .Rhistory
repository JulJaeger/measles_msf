group = case_when(
final_diagnoses_severe_acute_malnutrition == "TRUE" |
final_diagnoses_moderate_acute_malnutrition == "TRUE" ~ "SAM/MAM",
TRUE ~ "Other"
)
) %>%
group_by(epi_year, epi_week, group) %>%
summarise(
cases   = n(),
min_age = min(age_in_years, na.rm = TRUE),
max_age = max(age_in_years, na.rm = TRUE),
.groups = "drop"
) %>%
mutate(
age_range = paste0(min_age, "-", max_age, " years"),
hover_text = paste0(group, " cases: ", cases,
"<br>Age range: ", age_range,
"<br>Epi week: ", epi_week, " (", epi_year, ")")
)
epi_curve <- ggplot(
epi_cases_weekly,
aes(x = factor(epi_week, levels = unique(epi_week)),
y = cases, fill = group, text = hover_text)
) +
geom_col(position = "dodge", color = "black", size = 0.1) +   # dodge = side-by-side
labs(
title = "Weekly SAM/MAM vs Other Cases (CDC/MMWR epi week)",
x = "Epi Week",
y = "Cases",
fill = "Group"
) +
theme_minimal() +
theme(
plot.title  = element_text(face = "bold"),
axis.text.x = element_text(angle = 45, hjust = 1),
plot.margin = margin(5, 5, 5, 5)
)
