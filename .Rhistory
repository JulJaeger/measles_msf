cowplot::draw_plot(map_3, 0.57, 0.02, 0.3, 0.3)
map2_with_inset <- cowplot::ggdraw() +
cowplot::draw_plot(map_2, -0.3, 0.1, 1, 1) +
cowplot::draw_plot(map_4, -0.22, -0.03, 0.4, 0.4)
# Create a vertical divider line grob
divider <- grid::linesGrob(x = unit(c(0.5, 0.5), "npc"),
y = unit(c(0, 1), "npc"),
gp = grid::gpar(col = "black", lwd = 1))
# Combine maps side by side with divider
maps_combined <- (map1_with_inset | map2_with_inset) +
plot_layout(widths = c(0.6, 0.4)) &
theme(plot.margin = margin(0,0,0,0))
# Overlay the divider line across the combined panel
maps_with_divider <- cowplot::ggdraw(maps_combined) +
cowplot::draw_grob(divider)
# Stack maps and legend
final_map <- cowplot::plot_grid(
maps_with_divider,
legend,
ncol = 1,
rel_heights = c(1, 0.08)
)
final_map
# Remove margins and borders from maps
map_1 <- map_1 + theme(plot.margin = margin(0,0,0,0),
panel.border = element_blank())
map_2 <- map_2 + theme(plot.margin = margin(0,0,0,0),
panel.border = element_blank())
map_3 <- map_3 + theme(plot.margin = margin(0,0,0,0))
map_4 <- map_4 + theme(plot.margin = margin(0,0,0,0))
# Extract legend once
legend <- cowplot::get_legend(
map_1 + theme(legend.position = "bottom",
legend.title = element_text(face = "bold", size = 18),
legend.text  = element_text(size = 16))
)
# Build inset composites
map1_with_inset <- cowplot::ggdraw() +
cowplot::draw_plot(map_1, 0, 0, 1, 1) +
cowplot::draw_plot(map_3, 0.57, 0.02, 0.3, 0.3)
map2_with_inset <- cowplot::ggdraw() +
cowplot::draw_plot(map_2, -0.1, 0.1, 1, 1) +
cowplot::draw_plot(map_4, -0.22, -0.03, 0.4, 0.4)
# Create a vertical divider line grob
divider <- grid::linesGrob(x = unit(c(0.5, 0.5), "npc"),
y = unit(c(0, 1), "npc"),
gp = grid::gpar(col = "black", lwd = 1))
# Combine maps side by side with divider
maps_combined <- (map1_with_inset | map2_with_inset) +
plot_layout(widths = c(0.6, 0.4)) &
theme(plot.margin = margin(0,0,0,0))
# Overlay the divider line across the combined panel
maps_with_divider <- cowplot::ggdraw(maps_combined) +
cowplot::draw_grob(divider)
# Stack maps and legend
final_map <- cowplot::plot_grid(
maps_with_divider,
legend,
ncol = 1,
rel_heights = c(1, 0.08)
)
final_map
final_map
# case data
measles_data_imp <- read.csv(here("data/measles_data.csv")
)
View(measles_data_imp)
# case data
measles_data_imp <- read.csv(here("data/measles_data.csv")
)
measles_data <- measles_data_imp %>%
clean_names() %>%
dplyr::select(-c(1:3, 7, 8, 10, 11, 19:21, 23, 25, 30, 32, 34, 38, 40, 42, 52, 53, 59, 73)) %>%
mutate(
camp = if_else(
camp == "other",
specify_other_camp,
camp
)
) %>%
dplyr::select(-specify_other_camp) %>%
mutate(
block = str_remove(block, "^block_"),
camp = str_replace(camp, "^camp_", "Camp ")
) %>%
mutate(
camp = if_else(
camp == "KTP Register Camp", "Kutupalong RC",
camp
)
) %>%
mutate(
camp = case_when(
camp %in% c("Camp 1", "Camp 8") ~ paste0(camp, "E"),
TRUE ~ camp
)
) %>%
mutate(
date_of_visit = as.Date(date_of_visit, format = "%d/%m/%Y")
) %>%
mutate(block = stringr::str_to_sentence(block))
# case data
measles_data_imp <- read.csv(here("data/measles_data.csv")
)
measles_data <- measles_data_imp %>%
clean_names() %>%
dplyr::select(-c(1:3, 7, 8, 10, 11, 19:21, 23, 25, 30, 32, 34, 38, 40, 42, 52, 53, 59)) %>%
mutate(
camp = if_else(
camp == "other",
specify_other_camp,
camp
)
) %>%
dplyr::select(-specify_other_camp) %>%
mutate(
block = str_remove(block, "^block_"),
camp = str_replace(camp, "^camp_", "Camp ")
) %>%
mutate(
camp = if_else(
camp == "KTP Register Camp", "Kutupalong RC",
camp
)
) %>%
mutate(
camp = case_when(
camp %in% c("Camp 1", "Camp 8") ~ paste0(camp, "E"),
TRUE ~ camp
)
) %>%
mutate(
date_of_visit = as.Date(date_of_visit, format = "%d/%m/%Y")
) %>%
mutate(block = stringr::str_to_sentence(block))
measles_data <- measles_data %>%
mutate(ipd_opd = case_when(patient_id == "n/a" ~ "OPD",
TRUE ~ "IPD"))
#map data
sub_blocks <- st_read(here("data/Block_Boundary_V1/Block_Boundary_V1.shp"), quiet = TRUE) %>%
mutate(CampName_1 = str_remove(CampName_1, " Extension$"))
#merge datasets
cases_sf <- measles_data %>%
left_join(
sub_blocks,
by = c("camp" = "CampName_1",
"block" = "BlockLabel"
)
) %>%
st_as_sf()
# points for map
cases_points <- cases_sf %>%
filter(!is.na(District)) %>%
mutate(
geometry = map(
geometry,
~ st_sample(.x, size = 1) %>% st_cast("POINT")
)
) %>%
unnest(geometry) %>%
st_as_sf() %>%
st_set_crs(st_crs(sub_blocks))
