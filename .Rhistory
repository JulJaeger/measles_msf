epi_curve <- ggplot(
epi_cases,
aes(x = date_of_visit, y = case_id, fill = ipd_opd, text = hover_text)
) +
geom_tile(
width = 0.9,
height = 0.9,
color = "black"
) +
scale_x_date(
date_breaks = "1 day",
date_labels = "%d %b",
expand = c(0, 0)
) +
labs(
title = "Epidemic curve – measles",
subtitle = "April 03.04 - 26.04",
x = "Date",
y = "Cases",
fill = "Clinical severity"
) +
theme_minimal() +
theme(
plot.title = element_text(face = "bold"),
axis.text.x = element_text(angle = 45, hjust = 1),
plot.margin = margin(5, 5, 5, 5),
legend.position = "bottom",              # move legend below plot
legend.box = "horizontal",
)
