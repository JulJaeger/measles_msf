# ---- SECTION 7: Referral Sources for IPD ----
referral_ipd <- measles_data %>%
filter(ipd_opd == "IPD") %>%                     # IPD only
mutate(
referral_from = na_if(trimws(referral_from), "")
) %>%
filter(
!referral_from %in% c("n/a", "n_a")
) %>%
count(referral_from, name = "N_IPD") %>%
mutate(
Denominator = sum(N_IPD),
`% of IPD`  = round(N_IPD / Denominator * 100, 2)
) %>%
arrange(desc(N_IPD))
referral_levels <- c(
"OCP Goyalmara",
"OCP HoH",
"Other Facility",
"BRAC",
"IOM",
"OCA KTP",
"Self/Walk-in"
)
referral_ipd <- referral_ipd %>%
mutate(referral_from = factor(referral_from, levels = referral_levels)) %>%
arrange(referral_from)
referral_ft <- flextable::flextable(referral_ipd) |>
flextable::set_header_labels(
referral_from = "Referral Source",
N_IPD        = "N referred IPD",
Denominator  = "Total IPD",
`% of IPD`   = "% of IPD"
) |>
flextable::align(align = "center", part = "header") |>
flextable::align(
j = c("N_IPD", "Denominator", "% of IPD"),
align = "center",
part = "body"
) |>
flextable::align(j = "referral_from", align = "left", part = "body") |>
flextable::bold(part = "header") |>
flextable::fontsize(size = 10, part = "all") |>
flextable::autofit()
referral_ft
