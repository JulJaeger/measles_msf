#| title: "Referral Sources for IPD"
#| fig.asp: 1
#| out.width: 100%
#| fig.align: center
#| fig.margin: 0
# -----------------------------------------------------
# SECTION 7 — REFERRAL SOURCES FOR IPD
# -----------------------------------------------------
# 1. Define authoritative referral mapping
#    (raw values -> clean labels)
referral_map <- c(
ocp_goyalmara  = "OCP Goyalmara",
ocp_hoh        = "OCP HoH",
other_facility = "Other facility",
brac           = "BRAC",
iom            = "IOM",
oca_ktp        = "OCA KTP",
"n/a"          = "Self-walk-in",
"n_a"          = "Self-walk-in"
)
referral_levels <- c(
"OCP Goyalmara",
"OCP HoH",
"Other facility",
"BRAC",
"IOM",
"OCA KTP",
"Self-walk-in"
)
# 2. Clean, recode, and summarise IPD referrals
referral_ipd <- measles_data %>%
filter(ipd_opd == "IPD") %>%                 # IPD only
mutate(
referral_from = tolower(trimws(referral_from)),
Referral_Source = referral_map[referral_from]
) %>%
filter(!is.na(Referral_Source)) %>%           # drop anything unmapped
count(Referral_Source, name = "N_IPD") %>%
tidyr::complete(
Referral_Source = referral_levels,
fill = list(N_IPD = 0)
) %>%
mutate(
Denominator = sum(N_IPD),
`% of IPD`  = round(
ifelse(Denominator > 0, N_IPD / Denominator * 100, 0),
2
),
Referral_Source = factor(
Referral_Source,
levels = referral_levels
)
) %>%
arrange(Referral_Source)
# 3. Build dashboard-ready flextable
referral_ft <- flextable::flextable(referral_ipd) |>
flextable::set_header_labels(
Referral_Source = "Referral Source",
N_IPD           = "N referred IPD",
Denominator     = "Total IPD",
`% of IPD`      = "% of IPD"
) |>
flextable::align(align = "center", part = "header") |>
flextable::align(
j = c("N_IPD", "Denominator", "% of IPD"),
align = "center",
part = "body"
) |>
flextable::align(
j = "Referral_Source",
align = "left",
part = "body"
) |>
flextable::bold(part = "header") |>
flextable::fontsize(size = 10, part = "all") |>
flextable::autofit()
# Print table
referral_ft
referral_to_ipd <- measles_data %>%
filter(ipd_opd == "IPD") %>%
mutate(
referred_to = tolower(trimws(if_referred_where))
) %>%
filter(!is.na(referred_to), referred_to != "") %>%
mutate(
Referred_To = case_when(
referred_to == "oca_ktp"        ~ "OCA KTP",
referred_to == "ocp_goyalmara"  ~ "OCP Goyalmara",
TRUE                            ~ NA_character_
)
) %>%
filter(!is.na(Referred_To)) %>%
count(Referred_To, name = "N") %>%
mutate(
Denominator = N_IPD,
`% of IPD`  = round(N / Denominator * 100, 2)
)
total_referred_out <- referral_to_ipd %>%
summarise(
Referred_To = "Total referred out (any facility)",
N           = sum(N),
Denominator = N_IPD,
`% of IPD`  = round(N / Denominator * 100, 2)
)
referral_to_final <- bind_rows(
referral_to_ipd,
total_referred_out
)
from_header <- tibble(
Referral_Source = "REFERRALS FROM",
N_IPD = NA,
Denominator = NA,
`% of IPD` = NA
)
to_header <- tibble(
Referral_Source = "REFERRALS TO",
N_IPD = NA,
Denominator = NA,
`% of IPD` = NA
)
referral_from_table <- referral_ipd %>%
transmute(
Referral_Source,
N_IPD,
Denominator,
`% of IPD`
)
referral_to_table <- referral_to_final %>%
transmute(
Referral_Source = Referred_To,
N_IPD = N,
Denominator,
`% of IPD`
)
referral_combined <- bind_rows(
from_header,
referral_from_table,
to_header,
referral_to_table
)
referral_ft <- flextable::flextable(referral_combined) |>
flextable::set_header_labels(
Referral_Source = "Referral Source",
N_IPD           = "N (IPD)",
Denominator     = "Total IPD",
`% of IPD`      = "% of IPD"
) |>
flextable::align(align = "center", part = "header") |>
flextable::align(
j = c("N_IPD", "Denominator", "% of IPD"),
align = "center",
part = "body"
) |>
flextable::align(
j = "Referral_Source",
align = "left",
part = "body"
) |>
flextable::bold(part = "header") |>
# ✅ Bold the subheaders
flextable::bold(
i = referral_combined$Referral_Source %in%
c("REFERRALS FROM", "REFERRALS TO"),
part = "body"
) |>
flextable::fontsize(size = 10, part = "all") |>
flextable::autofit()
referral_ft
