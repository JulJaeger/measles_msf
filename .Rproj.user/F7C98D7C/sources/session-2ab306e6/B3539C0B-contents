#| title: "Clinical Severity"
#| fig.asp: 1
#| out.width: 100%
#| fig.align: center
#| fig.margin: 0
# Remove margins and borders from maps
map_1 <- map_1 + theme(plot.margin = margin(0,0,0,0),
                       panel.border = element_blank())
map_2 <- map_2 + theme(plot.margin = margin(0,0,0,0),
                       panel.border = element_blank())
map_3 <- map_3 + theme(plot.margin = margin(0,0,0,0))
map_4 <- map_4 + theme(plot.margin = margin(0,0,0,0))

# Extract legend once
legend <- cowplot::get_legend(
  map_1 + theme(legend.position = "bottom",
                legend.title = element_text(face = "bold", size = 18),
                legend.text  = element_text(size = 16))
)

# Build inset composites
map1_with_inset <- cowplot::ggdraw() +
  cowplot::draw_plot(map_1, -0.1, 0, 1, 1) +
  cowplot::draw_plot(map_3, 0.5, 0.02, 0.3, 0.3)

map2_with_inset <- cowplot::ggdraw() +
  cowplot::draw_plot(map_2, 0, 0, 1, 1) +
  cowplot::draw_plot(map_4, -0.2, -0.08, 0.5, 0.5)

# Create a vertical divider line grob
divider <- grid::linesGrob(x = unit(c(0.5, 0.5), "npc"),
                           y = unit(c(0, 1), "npc"),
                           gp = grid::gpar(col = "black", lwd = 1))

# Combine maps side by side with divider
maps_combined <- (map1_with_inset | map2_with_inset) +
  plot_layout(widths = c(0.6, 0.4)) &
  theme(plot.margin = margin(0,0,0,0))

# Overlay the divider line across the combined panel
maps_with_divider <- cowplot::ggdraw(maps_combined) +
  cowplot::draw_grob(divider)

# Stack maps and legend
final_map <- cowplot::plot_grid(
  maps_with_divider,
  legend,
  ncol = 1,
  rel_heights = c(0.5, 0.08)
)

final_map

