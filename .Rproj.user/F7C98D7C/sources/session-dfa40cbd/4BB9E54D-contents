### Epicurve  
```{r epicurve, results='asis'}
epi_cases <- measles_data %>%
  filter(!is.na(date_of_visit)) %>%
  arrange(date_of_visit) %>%
  group_by(date_of_visit) %>%
  mutate(case_id = row_number()) %>%
  ungroup()

ggplot(
  epi_cases,
  aes(x = date_of_visit, y = case_id, fill = clinical_severity)
) +
  geom_tile(width = 0.9, height = 0.9) +
  scale_x_date(date_breaks = "1 day", date_labels = "%d %b") +
  labs(
    x = "Date",
    y = "Cases",
    fill = "Clinical severity"
  ) +
  theme_minimal() +
  theme(axis.text.x = element_text(angle = 45, hjust = 1))
```
### Geographical distribution of cases
```{r first map, fig.show="hold", out.width="50%", fig.margin=FALSE}
map_severity <- ggplot() +
  geom_sf(sub_blocks, fill = "white", color = "grey80", linewidth = 0.1) +
  geom_sf(camp_boundaries, fill = NA, color = "black", linewidth = 0.6) +
  geom_sf(cases_points, aes(color = clinical_severity), size = 2, alpha = 0.7) +
  coord_sf(expand = FALSE) +
  theme_light() +
  theme(legend.position = "bottom")

map_phc <- ggplot() +
  geom_sf(sub_blocks, fill = "white", color = "grey80", linewidth = 0.1) +
  geom_sf(camp_boundaries, fill = NA, color = "black", linewidth = 0.6) +
  geom_sf(cases_points, aes(color = phc), size = 2, alpha = 0.7) +
  coord_sf(expand = FALSE) +
  theme_light() +
  theme(legend.position = "bottom")

